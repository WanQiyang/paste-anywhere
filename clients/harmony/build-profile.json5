{
  "app": {
    "signingConfigs": [],
    "products": [{
      "name": "default",
      "targetSdkVersion": "26.0.0",
      "compatibleSdkVersion": "26.0.0",
      "runtimeOS": "HarmonyOS",
      "buildOption": {
        "strictMode": { "caseSensitiveCheck": true, "useNormalizedOHMUrl": true }
      }
    }],
    "buildModeSet": [{ "name": "debug" }, { "name": "release" }],
    "capabilities": [{
      "bundleName": "com.ribo.pasteanywhere",
      "config": [{ "name": "Push Kit", "capability": "com.huawei.service.push.base_service" }]
    }]
  },
  "modules": [{
    "name": "entry",
    "srcPath": "./entry",
    "targets": [{ "name": "default", "applyToProducts": ["default"] }]
  }]
}
