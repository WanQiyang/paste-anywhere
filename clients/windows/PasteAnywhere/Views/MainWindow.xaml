<Window x:Class="PasteAnywhere.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:platform="clr-namespace:PasteAnywhere.Platform"
        Title="Paste Anywhere" Width="480" Height="780" MinWidth="420" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#1C2940" Background="#F4F6FA">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#F8FAFD" />
            <Setter Property="BorderBrush" Value="#DFE5EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#B0C3E5" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="#245CDB" />
                                <Setter TargetName="Field" Property="Background" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value="0.6" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#F8FAFD" />
            <Setter Property="BorderBrush" Value="#DFE5EF" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#B0C3E5" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Field" Property="BorderBrush" Value="#245CDB" />
                                <Setter TargetName="Field" Property="Background" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value="0.6" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#43536D" />
            <Setter Property="BorderBrush" Value="#DFE5EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#94BAFF" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#E9EEF6" />
                                <Setter Property="Foreground" Value="#9AA6BA" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClipboardActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="#F4F6FA" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#B42318" />
            <Setter Property="Background" Value="#FDEEEE" />
            <Setter Property="BorderBrush" Value="#F5CACA" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FADADA" />
                    <Setter Property="BorderBrush" Value="#ECAAAA" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#F5CACA" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LoginButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#245CDB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <AdornerDecorator>
    <Grid x:Name="SurfaceRoot">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer x:Name="LoginView" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center">
            <Grid MinHeight="{Binding ViewportHeight, ElementName=LoginView}">
            <StackPanel Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Width="352">
                <Image Source="/Assets/app-icon.png" Width="52" Height="52" Margin="0,0,0,16" />
                <TextBlock Text="Paste Anywhere" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,26" />
                <Border Background="White" BorderBrush="#E7ECF4" BorderThickness="1" CornerRadius="16" Padding="28,26">
                    <Border.Effect><DropShadowEffect Color="#273F6A" BlurRadius="32" ShadowDepth="6" Opacity="0.06" /></Border.Effect>
                    <StackPanel>
                <StackPanel x:Name="LoginFields">
                    <TextBlock Text="服务器地址" FontSize="12" Foreground="#64738B" Margin="0,0,0,7" />
                    <TextBox x:Name="ServerAddress" Height="38" TextChanged="LoginInputChanged" AutomationProperties.Name="服务器地址" />
                    <TextBlock Text="设备名" FontSize="12" Foreground="#64738B" Margin="0,17,0,7" />
                    <TextBox x:Name="DeviceName" Height="38" TextChanged="LoginInputChanged" AutomationProperties.Name="设备名" />
                    <TextBlock Text="配对码" FontSize="12" Foreground="#64738B" Margin="0,17,0,7" />
                    <PasswordBox x:Name="Invite" Height="38" PasswordChanged="LoginInputChanged" AutomationProperties.Name="配对码" />
                </StackPanel>
                <Button x:Name="ConnectButton" Content="配对" Style="{StaticResource LoginButton}" Click="ConnectClick" IsEnabled="False" IsDefault="True" Height="40" Margin="0,24,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="LoginStatus" Margin="8,16,8,0" TextWrapping="Wrap" FontSize="12" Foreground="#B45353" TextAlignment="Center" />
            </StackPanel>
            </Grid>
        </ScrollViewer>
    <ScrollViewer x:Name="MainView" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
        <StackPanel Margin="28,28,28,20">
            <DockPanel LastChildFill="True">
                <Button x:Name="LogoutButton" DockPanel.Dock="Right" Width="36" Height="36" Padding="8" Background="Transparent" BorderThickness="0" VerticalAlignment="Top"
                        Click="LogoutClick" ToolTip="登出" AutomationProperties.Name="登出">
                    <Path Data="M 10,4 H 4 V 20 H 10 M 8,12 H 21 M 16,7 L 21,12 L 16,17" Stroke="#66758A" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="20" Height="20" Stretch="Uniform" />
                </Button>
                <StackPanel>
                    <TextBlock Text="Paste Anywhere" FontSize="26" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                        <Ellipse x:Name="ConnectionLight" Width="8" Height="8" Fill="#DF6363" Margin="0,0,8,0" ToolTip="未连接" />
                        <TextBlock x:Name="AccountText" Foreground="#7C899D" FontSize="13" MaxWidth="310" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <TextBlock Text="在线用户" FontSize="12" FontWeight="Medium" Foreground="#7C899D" Margin="0,30,0,12" />
            <Border Background="White" CornerRadius="18" BorderBrush="#E7ECF4" BorderThickness="1" Padding="12">
                <ScrollViewer x:Name="UsersScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" PreviewMouseWheel="ScrollUsers">
                    <ItemsControl x:Name="UsersList">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="86" Height="86" Margin="0,0,8,0" CornerRadius="12" Padding="8" ToolTip="{Binding Name}"
                                        AllowDrop="True" DragEnter="UserDragOver" DragOver="UserDragOver" DragLeave="UserDragLeave" Drop="SendDrop">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F6F8FC" />
                                            <Setter Property="BorderBrush" Value="#F0F3F8" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                    <Setter Property="Background" Value="#EDF3FF" />
                                                    <Setter Property="BorderBrush" Value="#D6E3FF" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#AFC8F6" /></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initial}" FontSize="27" FontWeight="SemiBold" Foreground="#48658E" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#53677F" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <DockPanel Margin="0,28,0,12">
                <Button x:Name="ClearButton" Content="清空" DockPanel.Dock="Right" Click="ClearClick" IsEnabled="False"
                        Style="{StaticResource ClipboardActionButton}" Foreground="#D14343" />
                <Button x:Name="PasteButton" Content="粘贴" DockPanel.Dock="Right" Click="PasteClick" IsEnabled="False"
                        ToolTip="读取当前系统剪贴板并上传到在线剪贴板" Style="{StaticResource ClipboardActionButton}"
                        Foreground="#245CDB" Margin="0,0,8,0" />
                <TextBlock Text="在线剪贴板" FontSize="12" FontWeight="Medium" Foreground="#7C899D" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl x:Name="ClipboardList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="62" Margin="0,0,0,8" Padding="14,9" CornerRadius="12"
                                MouseLeftButtonDown="CardMouseDown" MouseMove="DragContent" MouseLeftButtonUp="CardMouseUp" LostMouseCapture="CardCaptureLost">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="BorderBrush" Value="#E7ECF4" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#AFC8F6" /></Trigger>
                                        <DataTrigger Binding="{Binding HasContent}" Value="False">
                                            <Setter Property="Background" Value="#F0F3F8" />
                                            <Setter Property="BorderBrush" Value="#E9EDF4" />
                                            <Setter Property="Opacity" Value="0.6" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number}" Foreground="#B1BDCE" FontSize="11" VerticalAlignment="Center" />
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Preview}" FontSize="14" Foreground="#34465F" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxHeight="20" />
                                    <TextBlock Grid.Row="1" Text="{Binding Time}" FontSize="10" Foreground="#A0ABBC" Margin="0,3,0,0" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
        <TextBlock Grid.Row="1" Text="{x:Static platform:AppVersion.Display}" FontSize="11" Foreground="#A1ACBC"
                   HorizontalAlignment="Center" Margin="0,4,0,12" />
        <Border x:Name="ToastPanel" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="24,0,24,24" MaxWidth="340" Background="#ED26364E" CornerRadius="12" Padding="16,10">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
        </Border>
    </Grid>
    </AdornerDecorator>
</Window>
