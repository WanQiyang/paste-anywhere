<Window x:Class="PasteAnywhere.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paste Anywhere" Width="680" Height="760" MinWidth="460" MinHeight="500" Background="#F4F6FA">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Paste Anywhere · 剪贴板同步" FontSize="26" FontWeight="SemiBold" />
            <TextBlock x:Name="AccountText" Text="尚未连接账号" Margin="0,8,0,0" Foreground="#43556C" />
            <TextBlock Text="服务器地址（公网使用 HTTPS）" Margin="0,16,0,4" />
            <TextBox x:Name="ServerAddress" Text="http://127.0.0.1:8080" />
            <TextBlock Text="设备名" Margin="0,8,0,4" /><TextBox x:Name="DeviceName" />
            <TextBlock Text="邀请码（仅首次连接需要）" Margin="0,8,0,4" /><PasswordBox x:Name="Invite" />
            <Button x:Name="ConnectButton" Content="连接并保存" Click="ConnectClick" Margin="0,8,0,0" Padding="8" />
            <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Content="设置发送快捷键" Click="ShortcutClick" Padding="8,4" />
                <TextBox x:Name="ShortcutText" Text="Ctrl+Alt+C" VerticalContentAlignment="Center" />
            </DockPanel>
            <TextBlock Text="当前远程内容（拖到下方用户即可发送）" Margin="0,16,0,8" />
            <Border Background="White" Padding="16" CornerRadius="12" MouseMove="DragContent">
                <StackPanel>
                    <Image x:Name="ContentImage" Visibility="Collapsed" MaxHeight="250" Stretch="Uniform" />
                    <TextBlock x:Name="ContentText" Text="连接后等待新通知，或手动刷新查看。" TextWrapping="Wrap" MaxHeight="200" />
                </StackPanel>
            </Border>
            <WrapPanel Margin="0,10,0,0">
                <Button Content="查看远程最新内容" Click="RefreshClick" Padding="8" Margin="0,0,8,0" />
                <Button Content="复制当前内容" Click="CopyClick" Padding="8" Margin="0,0,8,0" />
                <Button Content="历史记录" Click="HistoryClick" Padding="8" />
            </WrapPanel>
            <ListBox x:Name="UsersList" Margin="0,12,0,0" MaxHeight="150" AllowDrop="True" Drop="SendDrop">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Padding="12,6" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <ListBox x:Name="HistoryList" Visibility="Collapsed" MaxHeight="150" Margin="0,12,0,0" SelectionChanged="SelectHistory">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" MaxWidth="500" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="StatusText" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#43556C" />
            <TextBlock Text="先复制或截图，再按发送快捷键上传当前剪贴板。关闭窗口后驻留托盘；右键托盘可退出。" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</Window>
